# ==============================================================================
# Acadion Ecosystem — Unified Environment Configuration Template
# ==============================================================================
# Copy the relevant variables to each respective subsystem:
#   1. educate/backend/src/main/resources/application-local.properties
#   2. educate/frontend/.env
#   3. educate/logs/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service (Spring Boot 3 / Port 8080)
# ------------------------------------------------------------------------------
# MongoDB Connection String (Atlas URI or Local MongoDB instance)
SPRING_DATA_MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_URL>/acadiondb?retryWrites=true&w=majority
SPRING_DATA_MONGODB_DATABASE=acadiondb

# JWT Security Token Secret (Must be at least 256-bit secure secret string)
APP_JWT_SECRET=<YOUR_SECURE_256BIT_SECRET_KEY>
APP_JWT_EXPIRATION=86400000

# Brevo / SMTP Email Delivery Configuration (Optional)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<YOUR_BREVO_LOGIN_EMAIL>
SPRING_MAIL_PASSWORD=<YOUR_BREVO_SMTP_KEY>
APP_MAIL_FROM=Acadion Support <noreply@acadion.edu>

# ------------------------------------------------------------------------------
# 2. Frontend Application (React 18 + Vite / Port 5173)
# ------------------------------------------------------------------------------
# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 3. Machine Learning & RAG Vector Microservice (FastAPI / Port 5000)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for Multimodal RAG zero-hallucination tutor)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# OpenRouter AI API Key (Used for Question Paper extraction and question synthesis)
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
AI_MODEL_NAME=openrouter/free

# Tesseract OCR executable path (Optional: set if not in system PATH)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
