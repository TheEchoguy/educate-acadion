# Environment configuration for Acadion AI PPT Generator
# Phase 2: Gemini AI Content Planning

# Google Gemini API key (Required for AI generation mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-3-flash-preview, gemini-3.5-flash)
GEMINI_MODEL=gemini-3-flash-preview

# Application environment (development, production)
APP_ENV=development
