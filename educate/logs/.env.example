# ==============================================================================
# Acadion RAG Tutor & AI Paper Parser Microservice Environment Configuration
# Location: educate/logs/.env
# ==============================================================================

# Google Gemini API Key (Required for High-Precision Academic RAG Tutor)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Used for Question Paper extraction and question analysis)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model Identifier (Default: openrouter/free)
AI_MODEL_NAME=openrouter/free

# Tesseract OCR executable path (Optional: uncomment and set if not on system PATH)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
